# Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Application Settings
APP_NAME=RAG Backend
APP_VERSION=1.0.0
SECRET_KEY=your-secret-key-change-this-in-production

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1
SERVER_RELOAD=true

# Database Configuration - PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DATABASE=rag_backend

# Database Configuration - LanceDB
LANCEDB_PATH=./data/lancedb
LANCEDB_TABLE_NAME=embeddings

# Database Configuration - Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Embedding Model Configuration
EMBEDDING_MODEL=bge
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=768
EMBEDDING_DEVICE=cpu

# Text Chunking Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=128
MIN_CHUNK_SIZE=100
MAX_CHUNK_SIZE=1024
RESPECT_SENTENCE_BOUNDARIES=true
RESPECT_PARAGRAPH_BOUNDARIES=true

# LLM Configuration
LLM_API_ENDPOINT=http://localhost:8080
LLM_API_KEY=your-llm-api-key
LLM_MODEL_NAME=llama2-7b
LLM_TIMEOUT=30
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# Storage Configuration
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=pdf,docx,xlsx,txt,md

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE=./logs/app.log